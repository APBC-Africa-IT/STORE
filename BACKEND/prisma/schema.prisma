// MySpares database schema.
// We grow this file module by module (see the build guide §7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Identity & access ─────────────

enum UserType {
  CUSTOMER
  TRADE_CUSTOMER
  STAFF
  SUPPLIER_USER
  RIDER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  type            UserType
  status          UserStatus @default(ACTIVE)
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?    @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  totpSecretEnc   String?    @map("totp_secret_enc")
  totpEnabledAt   DateTime?  @map("totp_enabled_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  RESET_PASSWORD
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String
  purpose   OtpPurpose
  codeHash  String     @map("code_hash")
  attempts  Int        @default(0)
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ───────────── Platform ─────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  ip         String?
  userAgent  String?  @map("user_agent")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ───────────── Vehicles & fitment ─────────────

model VehicleMake {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now()) @map("created_at")
  models    VehicleModel[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id        String      @id @default(uuid()) @db.Uuid
  makeId    String      @map("make_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime    @default(now()) @map("created_at")
  make      VehicleMake @relation(fields: [makeId], references: [id])
  vehicles  Vehicle[]

  @@unique([makeId, slug])
  @@map("vehicle_models")
}

model Vehicle {
  id          String           @id @default(uuid()) @db.Uuid
  modelId     String           @map("model_id") @db.Uuid
  yearFrom    Int              @map("year_from")
  yearTo      Int              @map("year_to")
  engine      String? // e.g. "1.8L 2ZR-FE Petrol"
  variant     String? // trim / body / chassis code
  externalRef String?          @unique @map("external_ref") // TecDoc/AutoSync id later
  createdAt   DateTime         @default(now()) @map("created_at")
  model       VehicleModel     @relation(fields: [modelId], references: [id])
  fitments    ProductFitment[]

  @@index([modelId, yearFrom, yearTo])
  @@map("vehicles")
}

// ───────────── Catalogue ─────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QualityGrade {
  ECONOMY
  STANDARD
  PREMIUM
}

enum PartOrigin {
  OEM
  OES
  AFTERMARKET
}

enum PartCondition {
  NEW
  USED
  REMANUFACTURED
}

enum PartNumberType {
  OEM
  OES
  AFTERMARKET
  SUPERSEDED
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String
  slug      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("brands")
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  sku          String        @unique
  slug         String        @unique
  name         String
  description  String?
  brandId      String?       @map("brand_id") @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  status       ProductStatus @default(DRAFT)
  qualityGrade QualityGrade  @default(STANDARD) @map("quality_grade")
  origin       PartOrigin    @default(AFTERMARKET)
  condition    PartCondition @default(NEW)
  barcode      String?       @unique

  // Pricing — all money in cents (KES × 100). Retail/trade are VAT-inclusive.
  retailPriceCents Int       @map("retail_price_cents")
  salePriceCents   Int?      @map("sale_price_cents")
  saleStartsAt     DateTime? @map("sale_starts_at")
  saleEndsAt       DateTime? @map("sale_ends_at")
  tradePriceCents  Int?      @map("trade_price_cents")
  // STAFF-ONLY cost fields (never in customer responses)
  lastCostCents    Int?      @map("last_cost_cents")
  avgCostCents     Int?      @map("avg_cost_cents")
  minMarginBps     Int?      @map("min_margin_bps")
  coreChargeCents  Int       @default(0) @map("core_charge_cents")
  vatRateBps       Int       @default(1600) @map("vat_rate_bps")

  // Inventory policy (used from the inventory step)
  lowStockThreshold    Int     @default(3) @map("low_stock_threshold")
  reorderPoint         Int     @default(0) @map("reorder_point")
  reorderQty           Int     @default(0) @map("reorder_qty")
  sourcingLeadTimeMins Int?    @map("sourcing_lead_time_mins")
  isSourceable         Boolean @default(true) @map("is_sourceable")

  // Content
  specs          Json? // [{ "label": "Width", "value": "132 mm" }]
  warrantyText   String? @map("warranty_text")
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  weightGrams    Int?    @map("weight_grams")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand          Brand?             @relation(fields: [brandId], references: [id])
  category       Category           @relation(fields: [categoryId], references: [id])
  partNumbers    PartNumber[]
  fitments       ProductFitment[]
  inventory      InventoryLevel[]
  stockMovements StockMovement[]
  reservations   StockReservation[]

  @@index([categoryId, status])
  @@index([brandId])
  @@map("products")
}

model PartNumber {
  id           String         @id @default(uuid()) @db.Uuid
  productId    String         @map("product_id") @db.Uuid
  type         PartNumberType
  number       String // as printed, e.g. "04465-02220"
  normalized   String // uppercase, letters/digits only: "0446502220"
  manufacturer String?
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type, normalized])
  @@index([normalized])
  @@map("part_numbers")
}

model ProductFitment {
  productId String  @map("product_id") @db.Uuid
  vehicleId String  @map("vehicle_id") @db.Uuid
  notes     String?
  position  String? // Front / Rear / Left / Right
  verified  Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@id([productId, vehicleId])
  @@index([vehicleId])
  @@map("product_fitments")
}

// ───────────── Inventory ─────────────

model Location {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique // e.g. HUB-NBO
  name      String
  isDefault Boolean          @default(false) @map("is_default")
  address   String?
  createdAt DateTime         @default(now()) @map("created_at")
  bins      Bin[]
  levels    InventoryLevel[]

  @@map("locations")
}

model Bin {
  id         String           @id @default(uuid()) @db.Uuid
  locationId String           @map("location_id") @db.Uuid
  code       String // e.g. A-03-B2
  createdAt  DateTime         @default(now()) @map("created_at")
  location   Location         @relation(fields: [locationId], references: [id])
  levels     InventoryLevel[]

  @@unique([locationId, code])
  @@map("bins")
}

/// One row per product per location. available = on_hand - reserved (never stored).
model InventoryLevel {
  productId  String   @map("product_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  binId      String?  @map("bin_id") @db.Uuid
  onHand     Int      @default(0) @map("on_hand") // physically in the hub
  reserved   Int      @default(0) // promised to orders, not yet shipped
  version    Int      @default(0) // bumped on every change
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  product    Product  @relation(fields: [productId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
  bin        Bin?     @relation(fields: [binId], references: [id])

  @@id([productId, locationId])
  @@map("inventory_levels")
}

enum StockMovementReason {
  OPENING_BALANCE
  SALE
  GRN_RECEIPT
  CUSTOMER_RETURN
  DELIVERY_RETURNED
  RETURN_TO_SUPPLIER
  ADJUSTMENT_DAMAGED
  ADJUSTMENT_COUNTED
  ADJUSTMENT_STOLEN
  ADJUSTMENT_PROMO_WRITE_OFF
  ADJUSTMENT_FOUND
  TRANSFER_IN
  TRANSFER_OUT
}

/// Append-only history of every stock change. Never update or delete rows.
model StockMovement {
  id            String              @id @default(uuid()) @db.Uuid
  productId     String              @map("product_id") @db.Uuid
  locationId    String              @map("location_id") @db.Uuid
  quantity      Int // signed: +in, -out
  reason        StockMovementReason
  unitCostCents Int?                @map("unit_cost_cents")
  referenceType String?             @map("reference_type") // ORDER | GRN | STOCKTAKE | RMA | ADJUSTMENT
  referenceId   String?             @map("reference_id")
  note          String?
  actorId       String?             @map("actor_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  product       Product             @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

enum ReservationStatus {
  ACTIVE // holding stock
  COMMITTED // goods left the hub (sold)
  RELEASED // expired or cancelled
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  locationId  String            @map("location_id") @db.Uuid
  orderItemId String?           @map("order_item_id") @db.Uuid // linked in the orders step
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?         @map("expires_at") // set while an order awaits payment
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  product     Product           @relation(fields: [productId], references: [id])

  @@index([status, expiresAt])
  @@index([orderItemId])
  @@map("stock_reservations")
}

// ───────────── Delivery zones ─────────────

model DeliveryZone {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @unique // Westlands, Kilimani…
  slug                  String   @unique
  customerFeeCents      Int      @map("customer_fee_cents") // what the customer pays (VAT-inclusive)
  riderFeeCents         Int      @map("rider_fee_cents") // what we pay the boda boda rider
  expressSurchargeCents Int      @default(0) @map("express_surcharge_cents")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
}

// ───────────── Cart (never reserves stock — BR-002) ─────────────

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @unique @map("user_id") @db.Uuid
  guestTokenHash String?    @unique @map("guest_token_hash")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  items          CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ───────────── Orders ─────────────

enum OrderChannel {
  ONLINE
  WALK_IN
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  SOURCING
  PICKING
  PACKED
  READY_FOR_COLLECTION
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  COD_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
  CLICK_AND_COLLECT
  COUNTER
}

enum PaymentPlan {
  FULL
  DEPOSIT
  COD
}

enum ItemSource {
  STOCK
  SOURCED
}

enum ItemSourcingStatus {
  NOT_REQUIRED
  AWAITING_PO
  PO_SENT
  SUPPLIER_CONFIRMED
  RIDER_ASSIGNED
  COLLECTED
  RECEIVED
  FAILED
}

model Order {
  id                   String         @id @default(uuid()) @db.Uuid
  number               String         @unique // ORD-261020-00042
  channel              OrderChannel
  status               OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus        PaymentStatus  @default(UNPAID) @map("payment_status")
  paymentPlan          PaymentPlan    @map("payment_plan")
  customerId           String?        @map("customer_id") @db.Uuid
  contactName          String         @map("contact_name")
  contactPhone         String         @map("contact_phone")
  contactEmail         String?        @map("contact_email")
  deliveryMethod       DeliveryMethod @map("delivery_method")
  deliveryAddress      Json?          @map("delivery_address") // snapshot at order time
  deliveryZoneId       String?        @map("delivery_zone_id") @db.Uuid
  hasSourcedItems      Boolean        @default(false) @map("has_sourced_items")
  sourcingAcceptedAt   DateTime?      @map("sourcing_accepted_at")
  promisedBy           DateTime?      @map("promised_by")

  // Money (cents, VAT-inclusive)
  subtotalCents        Int            @map("subtotal_cents")
  discountCents        Int            @default(0) @map("discount_cents")
  deliveryFeeCents     Int            @default(0) @map("delivery_fee_cents")
  vatCents             Int            @map("vat_cents")
  totalCents           Int            @map("total_cents")
  depositRequiredCents Int            @default(0) @map("deposit_required_cents")
  amountPaidCents      Int            @default(0) @map("amount_paid_cents")
  amountRefundedCents  Int            @default(0) @map("amount_refunded_cents")

  paymentDueBy         DateTime?      @map("payment_due_by") // unpaid orders auto-cancel after this
  idempotencyKey       String?        @unique @map("idempotency_key")
  requestHash          String?        @map("request_hash")
  createdById          String?        @map("created_by_id") @db.Uuid // staff (POS)
  cancelledReason      String?        @map("cancelled_reason")
  version              Int            @default(0)
  placedAt             DateTime?      @map("placed_at")
  cancelledAt          DateTime?      @map("cancelled_at")
  deliveredAt          DateTime?      @map("delivered_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  items         OrderItem[]
  statusHistory OrderStatusEvent[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([status, paymentDueBy])
  @@map("orders")
}

model OrderItem {
  id             String             @id @default(uuid()) @db.Uuid
  orderId        String             @map("order_id") @db.Uuid
  productId      String             @map("product_id") @db.Uuid
  sku            String // snapshot
  name           String // snapshot
  quantity       Int
  unitPriceCents Int                @map("unit_price_cents") // VAT-inclusive
  lineTotalCents Int                @map("line_total_cents")
  vatRateBps     Int                @map("vat_rate_bps")
  vatCents       Int                @map("vat_cents")
  unitCostCents  Int?               @map("unit_cost_cents") // STAFF-ONLY, set at fulfilment
  source         ItemSource
  sourcingStatus ItemSourcingStatus @default(NOT_REQUIRED) @map("sourcing_status")
  leadTimeMins   Int?               @map("lead_time_mins")
  readyBy        DateTime?          @map("ready_by")
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sourcingStatus])
  @@map("order_items")
}

model OrderStatusEvent {
  id                  String       @id @default(uuid()) @db.Uuid
  orderId             String       @map("order_id") @db.Uuid
  fromStatus          OrderStatus? @map("from_status")
  toStatus            OrderStatus  @map("to_status")
  actorId             String?      @map("actor_id") @db.Uuid
  note                String?
  customerVisibleText String?      @map("customer_visible_text")
  createdAt           DateTime     @default(now()) @map("created_at")
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}
