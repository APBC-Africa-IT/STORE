@baseUrl = http://localhost:4000/api/v1
# Demo data IDs (from `pnpm db:seed`). Re-check with GET /products and GET /delivery-zones if you rebuild the database.
@productId = 5094d99d-67ab-4102-b038-5176d31a4c4b
@shockId = c0986922-4df8-48e5-a4ba-dff48ec98519
@zoneId = 2cf887f0-6b2e-4503-900d-7c35b29695e1

### Delivery zones
GET {{baseUrl}}/delivery-zones

### Quote: 2 brake pads (in stock) + 1 shock absorber (sourced), 30% deposit
POST {{baseUrl}}/checkout/quote
Content-Type: application/json

{
  "items": [
    { "productId": "{{productId}}", "quantity": 2 },
    { "productId": "{{shockId}}", "quantity": 1 }
  ],
  "deliveryMethod": "STANDARD",
  "deliveryZoneId": "{{zoneId}}",
  "paymentPlan": "DEPOSIT"
}

### Place the order (put the totalCents from the quote in expectedTotalCents)
POST {{baseUrl}}/orders
Content-Type: application/json
Idempotency-Key: 6f1c2a9e-5b7d-4e1a-9c3f-2d8b7a6e5f40

{
  "items": [
    { "productId": "{{productId}}", "quantity": 2 },
    { "productId": "{{shockId}}", "quantity": 1 }
  ],
  "deliveryMethod": "STANDARD",
  "deliveryZoneId": "{{zoneId}}",
  "paymentPlan": "DEPOSIT",
  "expectedTotalCents": 1680000,
  "acceptSourcingLeadTime": true,
  "contact": { "name": "Jane Wanjiku", "phone": "0712 345 678" },
  "address": { "line1": "Ring Road, Apt 4", "area": "Westlands" }
}

### Start M-Pesa payment for an order (guest: send the checkout phone as contactPhone)
POST {{baseUrl}}/orders/ORD-261020-00001/payments/mpesa
Content-Type: application/json
Idempotency-Key: 1b2c3d4e-0000-4000-8000-000000000001

{ "phone": "0712345678", "contactPhone": "0712345678" }

### Pretend the customer entered their PIN (DEV + fake mode only)
POST {{baseUrl}}/dev/mpesa/simulate/PASTE-PAYMENT-ID
Content-Type: application/json

{ "resultCode": 0 }

### Or pretend they cancelled on the phone
# { "resultCode": 1032 }

### Poll the payment (what the checkout page does every 3 seconds)
GET {{baseUrl}}/payments/PASTE-PAYMENT-ID
