NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL="postgresql://myspares:myspares@localhost:5433/myspares?schema=public"
REDIS_URL="redis://localhost:6379"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
JWT_ACCESS_SECRET="generate-with-node-crypto-randomBytes-48-base64url"
