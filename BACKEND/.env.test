FIELD_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
REQUIRE_STAFF_2FA=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_LOGIN_MAX=10
SEED_ADMIN_EMAIL="admin@test.local"
