# Test settings. Safe to commit: no real secrets here.
# Machine-specific overrides (e.g. a local Postgres password) go in .env.test.local, which is git-ignored.
NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL="postgresql://myspares:myspares@localhost:5433/myspares_test?schema=public"
REDIS_URL="redis://localhost:6379/1"
CORS_ORIGINS=""
